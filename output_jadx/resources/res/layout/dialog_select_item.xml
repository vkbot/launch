<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/DialogSelectRowOuter">
    <LinearLayout
        android:id="@+id/dialogSelectItemRow"
        style="@style/DialogSelectRowInner">
        <TextView
            android:id="@+id/dialogSelectItemLabel"
            style="@style/DialogSelectRowLabel"/>
        <ImageView
            android:id="@+id/dialogSelectItemCheck"
            style="@style/DialogSelectRowCheck"/>
    </LinearLayout>
    <View
        android:id="@+id/dialogSelectItemDivider"
        style="@style/DialogSelectRowDivider"/>
</LinearLayout>
