<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout style="@style/PopupHeaderRow">
        <TextView
            android:id="@+id/appListTitle"
            style="@style/PopupHeaderTitle"/>
        <TextView
            android:textSize="22sp"
            android:textColor="#ffff6b6b"
            android:id="@+id/appListError"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginEnd="16dp"/>
        <ProgressBar
            android:id="@+id/appListLoader"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="16dp"
            android:indeterminateTint="@color/system_text"
            style="?android:attr/progressBarStyleSmall"/>
        <ImageView
            android:id="@+id/appListRefresh"
            android:src="@drawable/ic_btn_refresh"
            android:contentDescription="Refresh"
            android:layout_marginEnd="80dp"
            style="@style/PopupHeaderButton"/>
        <ImageView
            android:id="@+id/appListTasks"
            android:visibility="gone"
            android:src="@drawable/ic_btn_tasks"
            android:contentDescription="Task manager"
            android:layout_marginEnd="80dp"
            style="@style/PopupHeaderButton"/>
        <ImageView
            android:id="@+id/appListSortAz"
            android:visibility="gone"
            android:src="@drawable/ic_btn_sort_az"
            android:contentDescription="Sort A-Z"
            android:layout_marginEnd="80dp"
            style="@style/PopupHeaderButton"/>
        <ImageView
            android:id="@+id/appListReorder"
            android:visibility="gone"
            android:src="@drawable/ic_btn_reorder"
            android:contentDescription="Arrange"
            android:layout_marginEnd="80dp"
            style="@style/PopupHeaderButton"/>
        <ImageView
            android:id="@+id/appListSettings"
            android:src="@drawable/ic_btn_settings"
            android:contentDescription="Settings"
            android:layout_marginEnd="80dp"
            style="@style/PopupHeaderButton"/>
        <ImageView
            android:id="@+id/appListBack"
            android:src="@drawable/ic_btn_close"
            android:contentDescription="Close"
            style="@style/PopupHeaderButton"/>
    </LinearLayout>
    <View
        android:id="@+id/appListHeaderDivider"
        style="@style/PopupHeaderDivider"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appListPager"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="0dp"
            android:paddingStart="20dp"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/appListDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"/>
    </FrameLayout>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/system_text"
        android:gravity="center"
        android:id="@+id/appListDeleteHint"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
