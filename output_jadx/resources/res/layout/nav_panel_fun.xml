<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="top|center_horizontal"
    android:orientation="vertical"
    android:id="@+id/navPanelRoot"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/btnNavPresets"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_nav_presets"
        android:scaleType="fitCenter"/>
    <ImageView
        android:id="@+id/btnNavBack"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_nav_back"
        android:scaleType="fitCenter"/>
    <ImageView
        android:id="@+id/btnNavApps"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_nav_apps"
        android:scaleType="fitCenter"/>
    <ImageView
        android:id="@+id/btnNavFactoryApps"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_nav_factory_apps"
        android:scaleType="fitCenter"/>
    <ImageView
        android:id="@+id/btnNavHome"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_nav_home"
        android:scaleType="fitCenter"/>
</LinearLayout>
