<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_small"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/iconContainer"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/preset_icon_container_size"
        android:layout_height="@dimen/preset_icon_container_size">
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/appIconBack"
            android:visibility="gone"
            android:layout_width="@dimen/preset_card_icon_size"
            android:layout_height="@dimen/preset_card_icon_size"
            android:contentDescription="Right app icon"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/appIconFront"
            android:layout_width="@dimen/preset_icon_size"
            android:layout_height="@dimen/preset_icon_size"
            android:contentDescription="App icon"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/preset_label_text_size"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/presetLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"/>
</LinearLayout>
