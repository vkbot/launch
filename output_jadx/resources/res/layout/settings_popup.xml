<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/popup_padding_start"
    android:paddingEnd="@dimen/popup_padding_end">
    <LinearLayout style="@style/PopupHeaderRow">
        <TextView
            android:id="@+id/settingsTitle"
            style="@style/PopupHeaderTitle"/>
        <ImageView
            android:id="@+id/settingsUninstall"
            android:src="@drawable/ic_btn_uninstall"
            android:contentDescription="Uninstall launcher"
            android:layout_marginEnd="80dp"
            style="@style/PopupHeaderButton"/>
        <ImageView
            android:id="@+id/settingsBack"
            android:src="@drawable/ic_btn_back"
            android:contentDescription="Back to apps"
            android:layout_marginEnd="80dp"
            style="@style/PopupHeaderButton"/>
        <ImageView
            android:id="@+id/settingsClose"
            android:src="@drawable/ic_btn_close"
            android:contentDescription="Close"
            style="@style/PopupHeaderButton"/>
    </LinearLayout>
    <View
        android:id="@+id/settingsHeaderDivider"
        style="@style/PopupHeaderDivider"/>
    <ScrollView
        android:scrollbarSize="6dp"
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/settingsContent"
        android:fadingEdgeLength="64dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:requiresFadingEdge="vertical">
        <LinearLayout
            android:orientation="horizontal"
            android:padding="24dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="16dp">
                <LinearLayout
                    android:id="@+id/settingsUnifiedRow"
                    android:focusable="true"
                    android:clickable="true"
                    style="@style/SettingsCard">
                    <LinearLayout style="@style/SettingsItemTexts">
                        <TextView
                            android:id="@+id/lblUnifiedLauncher"
                            style="@style/SettingsItemTitle"/>
                        <TextView
                            android:id="@+id/lblUnifiedLauncherDesc"
                            style="@style/SettingsItemDescription"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/settingsUnifiedValue"
                        android:maxWidth="300dp"
                        style="@style/SettingsValue"/>
                    <ImageView
                        android:id="@+id/settingsUnifiedArrow"
                        style="@style/SettingsRowArrow"/>
                </LinearLayout>
                <Space
                    android:id="@+id/settingsSportKeySpacer"
                    style="@style/SettingsSpacer"/>
                <LinearLayout
                    android:id="@+id/settingsSportKeyRow"
                    style="@style/SettingsCard">
                    <LinearLayout style="@style/SettingsItemTexts">
                        <TextView
                            android:id="@+id/lblSportKey"
                            style="@style/SettingsItemTitle"/>
                        <TextView
                            android:id="@+id/lblSportKeyDesc"
                            style="@style/SettingsItemDescription"/>
                    </LinearLayout>
                    <Switch
                        android:id="@+id/settingsSportKey"
                        style="@style/SettingsSwitch"/>
                </LinearLayout>
                <Space style="@style/SettingsSpacer"/>
                <LinearLayout
                    android:id="@+id/settingsPresetSizeRow"
                    android:focusable="true"
                    android:clickable="true"
                    style="@style/SettingsCard">
                    <LinearLayout style="@style/SettingsItemTexts">
                        <TextView
                            android:id="@+id/lblPresetSize"
                            style="@style/SettingsItemTitle"/>
                        <TextView
                            android:id="@+id/lblPresetSizeDesc"
                            style="@style/SettingsItemDescription"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/settingsPresetSizeValue"
                        style="@style/SettingsValue"/>
                    <ImageView
                        android:id="@+id/settingsPresetSizeArrow"
                        style="@style/SettingsRowArrow"/>
                </LinearLayout>
                <Space style="@style/SettingsSpacer"/>
                <LinearLayout
                    android:id="@+id/settingsCoversRow"
                    android:focusable="true"
                    android:clickable="true"
                    style="@style/SettingsCard">
                    <LinearLayout style="@style/SettingsItemTexts">
                        <TextView
                            android:id="@+id/lblCovers"
                            style="@style/SettingsItemTitle"/>
                        <TextView
                            android:id="@+id/lblCoversDesc"
                            style="@style/SettingsItemDescription"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/settingsCoversValue"
                        style="@style/SettingsValue"/>
                    <ImageView
                        android:id="@+id/settingsCoversArrow"
                        style="@style/SettingsRowArrow"/>
                </LinearLayout>
                <Space style="@style/SettingsSpacer"/>
                <LinearLayout style="@style/SettingsCard">
                    <LinearLayout style="@style/SettingsItemTexts">
                        <TextView
                            android:id="@+id/lblHideBack"
                            style="@style/SettingsItemTitle"/>
                        <TextView
                            android:id="@+id/lblHideBackDesc"
                            style="@style/SettingsItemDescription"/>
                    </LinearLayout>
                    <Switch
                        android:id="@+id/settingsHideBack"
                        style="@style/SettingsSwitch"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="16dp">
                <LinearLayout
                    android:id="@+id/settingsUpdateLauncherRow"
                    android:focusable="true"
                    android:clickable="true"
                    style="@style/SettingsCard">
                    <LinearLayout style="@style/SettingsItemTexts">
                        <TextView
                            android:id="@+id/lblUpdateLauncher"
                            style="@style/SettingsItemTitle"/>
                        <TextView
                            android:id="@+id/lblUpdateLauncherDesc"
                            style="@style/SettingsItemDescription"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/btnUpdateLauncher"
                        android:clickable="false"
                        style="@style/SettingsButton"/>
                </LinearLayout>
                <Space style="@style/SettingsSpacer"/>
                <LinearLayout
                    android:id="@+id/settingsAutostartRow"
                    android:focusable="true"
                    android:clickable="true"
                    style="@style/SettingsCard">
                    <LinearLayout style="@style/SettingsItemTexts">
                        <TextView
                            android:id="@+id/lblAutostart"
                            style="@style/SettingsItemTitle"/>
                        <TextView
                            android:id="@+id/lblAutostartDesc"
                            style="@style/SettingsItemDescription"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/settingsAutostartValue"
                        style="@style/SettingsValue"/>
                    <ImageView
                        android:id="@+id/settingsAutostartArrow"
                        style="@style/SettingsRowArrow"/>
                </LinearLayout>
                <Space style="@style/SettingsSpacer"/>
                <LinearLayout style="@style/SettingsCard">
                    <LinearLayout style="@style/SettingsItemTexts">
                        <TextView
                            android:id="@+id/lblTimeZone"
                            style="@style/SettingsItemTitle"/>
                        <TextView
                            android:id="@+id/lblTimeZoneDesc"
                            style="@style/SettingsItemDescription"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="32sp"
                            android:textColor="@color/system_text"
                            android:gravity="center"
                            android:id="@+id/settingsClockMinus"
                            android:background="@color/surface_dark"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:text="−"/>
                        <TextView
                            android:textSize="22sp"
                            android:textColor="@color/system_text"
                            android:gravity="center"
                            android:id="@+id/settingsClockOffset"
                            android:layout_width="80dp"
                            android:layout_height="60dp"/>
                        <TextView
                            android:textSize="32sp"
                            android:textColor="@color/system_text"
                            android:gravity="center"
                            android:id="@+id/settingsClockPlus"
                            android:background="@color/surface_dark"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:text="+"/>
                    </LinearLayout>
                </LinearLayout>
                <Space style="@style/SettingsSpacer"/>
                <LinearLayout
                    android:id="@+id/settingsLanguageRow"
                    android:focusable="true"
                    android:clickable="true"
                    style="@style/SettingsCard">
                    <LinearLayout style="@style/SettingsItemTexts">
                        <TextView
                            android:id="@+id/lblLanguage"
                            style="@style/SettingsItemTitle"/>
                        <TextView
                            android:id="@+id/lblLanguageDesc"
                            style="@style/SettingsItemDescription"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/settingsLanguageFlag"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:scaleType="fitCenter"
                        android:layout_marginEnd="12dp"/>
                    <TextView
                        android:id="@+id/settingsLanguageValue"
                        style="@style/SettingsValue"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
