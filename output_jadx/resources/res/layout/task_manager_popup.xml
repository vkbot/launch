<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/taskManagerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout style="@style/PopupHeaderRow">
            <TextView
                android:id="@+id/taskManagerTitle"
                style="@style/PopupHeaderTitle"/>
            <TextView
                android:textSize="26sp"
                android:id="@+id/taskManagerMemory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginEnd="60dp"/>
            <ImageView
                android:id="@+id/taskManagerCloseAll"
                android:src="@drawable/ic_btn_close_all"
                android:contentDescription="Close all"
                android:layout_marginEnd="80dp"
                style="@style/PopupHeaderButton"/>
            <ImageView
                android:id="@+id/taskManagerClose"
                android:src="@drawable/ic_btn_close"
                android:contentDescription="Close"
                style="@style/PopupHeaderButton"/>
        </LinearLayout>
        <View
            android:id="@+id/taskManagerDivider"
            style="@style/PopupHeaderDivider"/>
    </LinearLayout>
    <FrameLayout
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center_vertical"
            android:id="@+id/taskManagerList"
            android:scrollbars="none"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/task_card_height"
            android:overScrollMode="never"
            android:layout_marginStart="@dimen/margin_left"
            android:layout_marginEnd="@dimen/margin_right"/>
        <TextView
            android:textSize="36sp"
            android:layout_gravity="center"
            android:id="@+id/taskManagerEmpty"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <TextView
        android:textSize="18sp"
        android:gravity="center"
        android:id="@+id/taskManagerHint"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
