<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="60px">
        <FrameLayout
            android:id="@+id/leftPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/leftPlusIcon"
                android:layout_width="@dimen/add_app_icon_size"
                android:layout_height="@dimen/add_app_icon_size"
                android:src="@drawable/ic_add_app"
                android:contentDescription="Add left app"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/leftAppSelected"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/leftAppIcon"
                    android:layout_width="@dimen/selected_app_icon_size"
                    android:layout_height="@dimen/selected_app_icon_size"
                    android:contentDescription="Left app icon"/>
                <TextView
                    android:textSize="@dimen/selected_app_text_size"
                    android:textColor="@color/app_label"
                    android:id="@+id/leftAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"/>
            </LinearLayout>
        </FrameLayout>
        <View
            android:id="@+id/divider"
            android:background="@color/btn_border"
            android:layout_width="@dimen/divider_width"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/rightPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/rightPlusIcon"
                android:layout_width="@dimen/add_app_icon_size"
                android:layout_height="@dimen/add_app_icon_size"
                android:src="@drawable/ic_add_app"
                android:contentDescription="Add right app"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/rightAppSelected"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/rightAppIcon"
                    android:layout_width="@dimen/selected_app_icon_size"
                    android:layout_height="@dimen/selected_app_icon_size"
                    android:contentDescription="Right app icon"/>
                <TextView
                    android:textSize="@dimen/selected_app_text_size"
                    android:textColor="@color/app_label"
                    android:id="@+id/rightAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ratioIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28px">
        <ImageView
            android:id="@+id/ratioArrowLeft"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="Drag left"/>
        <TextView
            android:textSize="36sp"
            android:textColor="@color/system_text"
            android:id="@+id/ratioText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50  50"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <ImageView
            android:id="@+id/ratioArrowRight"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_right"
            android:contentDescription="Drag right"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/actionButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <ImageView
            android:id="@+id/confirmButton"
            android:background="@drawable/btn_action_bg"
            android:padding="20px"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="100px"
            android:layout_height="100px"
            android:src="@drawable/ic_check"
            android:contentDescription="Save"
            android:alpha="0.3"/>
        <View
            android:layout_width="90px"
            android:layout_height="1px"/>
        <ImageView
            android:id="@+id/deleteButton"
            android:background="@drawable/btn_action_bg"
            android:padding="20px"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="100px"
            android:layout_height="100px"
            android:src="@drawable/ic_delete"
            android:contentDescription="Delete"/>
    </LinearLayout>
</FrameLayout>
