    <LinearLayout android:gravity="center_vertical" android:layout_gravity="center" android:orientation="horizontal" android:id="@id/ratioIndicator" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="28.0px">
        <ImageView android:id="@id/ratioArrowLeft" android:layout_width="48.0dip" android:layout_height="48.0dip" android:src="@drawable/ic_arrow_left" android:contentDescription="Drag left" />
        <TextView android:textSize="36.0sp" android:textColor="@color/system_text" android:id="@id/ratioText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="50  50" android:layout_marginStart="8.0dip" android:layout_marginEnd="8.0dip" />
        <ImageView android:id="@id/ratioArrowRight" android:layout_width="48.0dip" android:layout_height="48.0dip" android:src="@drawable/ic_arrow_right" android:contentDescription="Drag right" />
    </LinearLayout>
    <LinearLayout android:gravity="center" android:layout_gravity="center|top" android:orientation="horizontal" android:id="@id/actionButtons" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16.0dip">
        <ImageView android:id="@id/confirmButton" android:background="@drawable/btn_action_bg" android:padding="20.0px" android:focusable="true" android:clickable="true" android:layout_width="100.0px" android:layout_height="100.0px" android:src="@drawable/ic_check" android:contentDescription="Save" android:alpha="0.3" />
        <View android:layout_width="90.0px" android:layout_height="1.0px" />
        <ImageView android:id="@id/deleteButton" android:background="@drawable/btn_action_bg" android:padding="20.0px" android:focusable="true" android:clickable="true" android:layout_width="100.0px" android:layout_height="100.0px" android:src="@drawable/ic_delete" android:contentDescription="Delete" />
    </LinearLayout>
</FrameLayout>