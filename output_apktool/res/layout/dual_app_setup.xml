<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_marginBottom="60.0px">
        <FrameLayout android:id="@id/leftPanel" android:layout_width="0.0dip" android:layout_height="fill_parent" android:layout_weight="1.0">
            <ImageView android:layout_gravity="center" android:id="@id/leftPlusIcon" android:layout_width="@dimen/add_app_icon_size" android:layout_height="@dimen/add_app_icon_size" android:src="@drawable/ic_add_app" android:contentDescription="Add left app" />
            <LinearLayout android:gravity="center" android:layout_gravity="center" android:orientation="vertical" android:id="@id/leftAppSelected" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <ImageView android:id="@id/leftAppIcon" android:layout_width="@dimen/selected_app_icon_size" android:layout_height="@dimen/selected_app_icon_size" android:contentDescription="Left app icon" />
                <TextView android:textSize="@dimen/selected_app_text_size" android:textColor="@color/app_label" android:id="@id/leftAppName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_small" />
            </LinearLayout>
        </FrameLayout>
        <View android:id="@id/divider" android:background="@color/btn_border" android:layout_width="@dimen/divider_width" android:layout_height="fill_parent" />
        <FrameLayout android:id="@id/rightPanel" android:layout_width="0.0dip" android:layout_height="fill_parent" android:layout_weight="1.0">
            <ImageView android:layout_gravity="center" android:id="@id/rightPlusIcon" android:layout_width="@dimen/add_app_icon_size" android:layout_height="@dimen/add_app_icon_size" android:src="@drawable/ic_add_app" android:contentDescription="Add right app" />
